{
  "cli": {
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APPLE_HEALTH": "1"
      }
    },
    "production": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "APPLE_HEALTH": "1"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
